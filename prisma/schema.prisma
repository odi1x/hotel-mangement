generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  username         String      @unique
  password         String
  name             String?
  profilePicture   String?
  role             String      @default("admin")
  adminId          String?
  canBook          Boolean     @default(true)
  canEdit          Boolean     @default(true)
  canDelete        Boolean     @default(true)
  canViewAnalytics Boolean     @default(true)
  canViewSettings  Boolean     @default(true)
  businessName     String?
  tourismLicense   String?
  logoUrl          String?
  stampUrl         String?
  customTerms      String?
  taxEnabled       Boolean     @default(false)
  taxPercentage    Decimal?
  apartmentTypes   String?
  bookingSources   String?

  generalExpenses  Decimal?

  createdAt        DateTime    @default(now())

  admin            User?       @relation("AdminStaff", fields: [adminId], references: [id])
  staff            User[]      @relation("AdminStaff")

  apartments        Apartment[]
  bookings          Booking[]
  licenses          License[]
  staffExpenses     StaffExpense[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  maintenanceIssues MaintenanceIssue[]
  pricingRules      PricingRule[]
}

model License {
  id             String    @id @default(uuid())
  userId         String
  licenseNumber  String
  expirationDate DateTime?
  createdAt      DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartments    Apartment[]
}

model Apartment {
  id            String    @id @default(uuid())
  userId        String
  name          String
  type          String
  description   String?
  basePrice     Decimal
  needsCleaning Boolean   @default(false)
  lastCleanedAt DateTime  @default(now())

  rentCost           Decimal?
  rentPeriod         String?
  cleaningType       String?   @default("salaried")
  cleaningCost       Decimal?
  platformFeeType    String?
  platformFee        Decimal?
  images             String[]  @default([])
  coverPhoto         String?
  otherExpenseLabel  String?
  otherExpenseAmount Decimal?

  licenseId     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings           Booking[]
  maintenanceIssues  MaintenanceIssue[]
  pricingRules       PricingRule[]

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  license       License?  @relation(fields: [licenseId], references: [id], onDelete: SetNull)
}

model Booking {
  id            String    @id @default(uuid())
  userId        String
  apartmentId   String
  residentName  String
  residentId    String
  phone         String
  address       String?
  pricePerNight Decimal
  totalPrice    Decimal?
  source        String    @default("زيارة مباشرة")
  startDate     DateTime
  endDate       DateTime
  status          String    @default("active")
  notes           String?
  customerRequest String?
  creatorName     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]
}

model Payment {
  id          String    @id @default(uuid())
  bookingId   String
  userId      String
  amount      Decimal
  date        DateTime  @default(now())
  method      String    @default("cash")
  type        String    @default("payment")
  notes       String?
  collectedBy String?
  createdAt   DateTime  @default(now())

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
}

/// A single maintenance issue against an apartment. History is preserved
/// forever (no delete-on-resolve) so the analytics view can eventually surface
/// repeat problems per unit and total maintenance costs per period.
model MaintenanceIssue {
  id          String    @id @default(uuid())
  apartmentId String
  userId      String    // owner (admin) userId — scopes queries
  title       String
  description String?
  category    String    @default("other")
  // "hvac" | "plumbing" | "electrical" | "furniture" | "appliances" | "deep_clean" | "other"
  severity    String    @default("normal")
  // "urgent" | "normal" | "improvement"
  status      String    @default("open")
  // "open" | "in_progress" | "resolved"
  reportedBy  String?   // staff name who logged the issue
  cost        Decimal?  // final cost after resolution (feeds owner statements later)
  contractor  String?   // who fixed it — helps track which vendors are reliable
  notes       String?
  images      String[]  @default([])
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@index([userId])
  @@index([status])
}

/// A seasonal or dynamic pricing rule. Applies to either a specific apartment
/// (apartmentId set) or ALL apartments (apartmentId null). When multiple rules
/// overlap on a date, the one with the highest `priority` wins. Ties are broken
/// by specificity: a unit-specific rule beats a global rule at equal priority.
model PricingRule {
  id           String    @id @default(uuid())
  userId       String    // owner (admin) userId — scopes queries
  apartmentId  String?   // null = applies to all apartments
  label        String    // e.g. "موسم الحج ١٤٤٧", "شهر رمضان", "عطلة نهاية الأسبوع"
  startDate    DateTime
  endDate      DateTime
  priceMode    String    @default("multiplier")  // "fixed" or "multiplier"
  value        Decimal   // if fixed: SAR/night. if multiplier: e.g. 2.5 = 2.5×basePrice
  priority     Int       @default(50)  // 0–100; higher wins on overlap
  daysOfWeek   Int[]     @default([])  // [] = every day; else 0=Sun..6=Sat, so Saudi weekend = [5,6]
  color        String    @default("#059669")  // hex, for calendar visualization
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  apartment    Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apartmentId])
  @@index([startDate, endDate])
}

model StaffExpense {
  id            String    @id @default(uuid())
  userId        String
  name          String
  monthlySalary Decimal
  scope         String?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  isCleared Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  subscription Json
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
