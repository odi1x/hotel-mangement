generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  username         String      @unique
  password         String
  name             String?
  profilePicture   String?
  role             String      @default("admin")
  adminId          String?
  canBook          Boolean     @default(true)
  canEdit          Boolean     @default(true)
  canDelete        Boolean     @default(true)
  canViewAnalytics Boolean     @default(true)
  canViewSettings  Boolean     @default(true)
  businessName     String?
  tourismLicense   String?
  logoUrl          String?
  stampUrl         String?
  customTerms      String?
  taxEnabled       Boolean     @default(false)
  taxPercentage    Decimal?
  apartmentTypes   String?
  bookingSources   String?

  generalExpenses  Decimal?

  createdAt        DateTime    @default(now())

  admin            User?       @relation("AdminStaff", fields: [adminId], references: [id])
  staff            User[]      @relation("AdminStaff")

  apartments       Apartment[]
  bookings         Booking[]
  licenses         License[]
  staffExpenses    StaffExpense[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
}

model License {
  id             String    @id @default(uuid())
  userId         String
  licenseNumber  String
  expirationDate DateTime?
  createdAt      DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartments    Apartment[]
}

model Apartment {
  id            String    @id @default(uuid())
  userId        String
  name          String
  type          String
  description   String?
  basePrice     Decimal
  needsCleaning Boolean   @default(false)
  lastCleanedAt DateTime  @default(now())

  rentCost           Decimal?
  rentPeriod         String?   // "monthly" or "yearly"
  cleaningType       String?   @default("salaried") // "salaried" or "per_booking"
  cleaningCost       Decimal?
  platformFeeType    String?   // "percentage" or "fixed"
  platformFee        Decimal?
  otherExpenseLabel  String?
  otherExpenseAmount Decimal?

  licenseId     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  license       License?  @relation(fields: [licenseId], references: [id], onDelete: SetNull)
}

model Booking {
  id            String    @id @default(uuid())
  userId        String
  apartmentId   String
  residentName  String
  residentId    String
  phone         String
  address       String?
  pricePerNight Decimal
  totalPrice    Decimal?
  source        String    @default("زيارة مباشرة")
  startDate     DateTime
  endDate       DateTime
  status        String    @default("active") // "active", "completed", "checked_out_early"
  trusted       Boolean   @default(false)
  notes         String?
  creatorName   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffExpense {
  id            String    @id @default(uuid())
  userId        String
  name          String
  monthlySalary Decimal
  scope         String?   // Comma-separated apartment IDs or empty for 'all'
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // 'info', 'success', 'warning', 'booking'
  isRead    Boolean  @default(false)
  isCleared Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  subscription Json
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
